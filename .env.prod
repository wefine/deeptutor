# DeepTutor v1.3.8 — 多用户生产环境
TZ=Asia/Shanghai

# LLM（两个用户共享）
LLM_BINDING=xiaomi_mimo
LLM_MODEL=mimo-v2.5-pro
LLM_API_KEY=tp-ccgjqxhgnxkn8ub
LLM_HOST=https://token-plan-cn.xiaomimimo.com/v1
LLM_API_VERSION=

# Embedding（LM Studio 跑在 Mac 宿主机）
EMBEDDING_BINDING=lm_studio
EMBEDDING_MODEL=qwen3-embedding-8b-q4km
EMBEDDING_API_KEY=lm-studio
EMBEDDING_HOST=http://host.docker.internal:1234/v1/embeddings
EMBEDDING_DIMENSION=
EMBEDDING_API_VERSION=
EMBEDDING_SEND_DIMENSIONS=false

# Ports（容器内部端口，保持默认）
BACKEND_PORT=8001
FRONTEND_PORT=3782

# 对外 API Base（统一域名）
NEXT_PUBLIC_API_BASE_EXTERNAL=https://deeptutor.home
NEXT_PUBLIC_API_BASE=

DISABLE_SSL_VERIFY=false

# =============================================
# 认证与多用户
# =============================================
AUTH_ENABLED=true
# JWT 签名密钥（留空让系统自动在 multi-user/_system/auth/ 生成）
AUTH_SECRET=
AUTH_TOKEN_EXPIRE_HOURS=168
AUTH_COOKIE_SECURE=false

# 不用 PocketBase（多用户模式必须留空）
POCKETBASE_URL=

# 版本号
APP_VERSION=v1.3.9
